# LLM and Search API Keys
GROQ_API_KEYS=key1,key2,key3
TAVILY_API_KEY=your_tavily_api_key_here

# GitHub Token for MCP Servers or Git operations
GITHUB_TOKEN=your_github_token_here

# Observability (LangSmith)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=agentic-research-copilot

# Postgres (Supabase Connection String)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=your_supabase_connection_string_here
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_api_key_here

# Qdrant (Local Path for embedded mode)
QDRANT_PATH=./qdrant_data
